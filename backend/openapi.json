  "components": {
    "schemas": {
      "CandidateScore": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "relevance": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Relevance"
          },
          "level_fit": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Level Fit"
          },
          "teaching": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Teaching"
          },
          "density": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Density"
          },
          "captions": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Captions"
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "video_id",
          "relevance",
          "level_fit",
          "teaching",
          "density",
          "captions",
          "reason"
        ],
        "title": "CandidateScore"
      },
      "Connection": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,19}$",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source",
          "target"
        ],
        "title": "Connection"
      },
      "DiagramNode": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,19}$",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "maxLength": 44,
            "minLength": 1,
            "title": "Label"
          },
          "detail": {
            "type": "string",
            "maxLength": 70,
            "title": "Detail",
            "default": ""
          },
          "slot": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Slot"
          },
          "shape": {
            "type": "string",
            "enum": [
              "box",
              "circle",
              "bar"
            ],
            "title": "Shape",
            "default": "box"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "role": {
            "type": "string",
            "enum": [
              "neutral",
              "start",
              "step",
              "result",
              "warning",
              "good",
              "bad"
            ],
            "title": "Role",
            "default": "neutral"
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "slot"
        ],
        "title": "DiagramNode"
      },
      "DiagramState": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,19}$",
            "title": "Id"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "label": {
            "type": "string",
            "maxLength": 44,
            "minLength": 1,
            "title": "Label"
          },
          "detail": {
            "type": "string",
            "maxLength": 70,
            "minLength": 3,
            "title": "Detail"
          },
          "role": {
            "type": "string",
            "enum": [
              "neutral",
              "start",
              "step",
              "result",
              "warning",
              "good",
              "bad"
            ],
            "title": "Role",
            "default": "neutral"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "target",
          "label",
          "detail"
        ],
        "title": "DiagramState"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "EvidenceRef": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "segment_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Segment Ids"
          },
          "start_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Ms"
          },
          "end_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Ms"
          },
          "quote": {
            "type": "string",
            "maxLength": 1800,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "segment_ids",
          "quote"
        ],
        "title": "EvidenceRef"
      },
      "ExplanationRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "example",
              "again"
            ],
            "title": "Kind"
          },
          "added_seconds": {
            "type": "integer",
            "const": 40,
            "title": "Added Seconds",
            "default": 40
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "request_id"
        ],
        "title": "ExplanationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "stage": {
            "type": "string",
            "title": "Stage",
            "default": "queued"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "complete",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status",
            "default": "queued"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_sequence": {
            "type": "integer",
            "title": "Event Sequence",
            "default": 0
          },
          "stage_timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Stage Timings",
            "default": {}
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "lesson_id",
          "created_at",
          "updated_at"
        ],
        "title": "Job"
      },
      "LearningRequest": {
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Goal"
          },
          "prior_knowledge": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Prior Knowledge",
            "default": "beginner"
          },
          "time_budget_seconds": {
            "type": "integer",
            "maximum": 1200.0,
            "minimum": 60.0,
            "title": "Time Budget Seconds",
            "default": 300
          },
          "language": {
            "type": "string",
            "const": "en",
            "title": "Language",
            "default": "en"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "goal",
          "request_id"
        ],
        "title": "LearningRequest"
      },
      "Lesson": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "request": {
            "$ref": "#/components/schemas/SavedLearningRequest"
          },
          "objectives": {
            "items": {
              "$ref": "#/components/schemas/Objective"
            },
            "type": "array",
            "title": "Objectives",
            "default": []
          },
          "short_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Short Ids",
            "default": []
          },
          "shorts": {
            "items": {
              "$ref": "#/components/schemas/Short"
            },
            "type": "array",
            "title": "Shorts",
            "default": []
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "preparing",
              "partially_ready",
              "ready",
              "failed",
              "cancelled",
              "interrupted"
            ],
            "title": "Status",
            "default": "queued"
          },
          "planned_duration_ms": {
            "type": "integer",
            "title": "Planned Duration Ms",
            "default": 0
          },
          "original_planned_duration_ms": {
            "type": "integer",
            "title": "Original Planned Duration Ms",
            "default": 0
          },
          "extra_allowance_ms": {
            "type": "integer",
            "title": "Extra Allowance Ms",
            "default": 0
          },
          "job": {
            "$ref": "#/components/schemas/Job"
          },
          "provider_settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provider Settings",
            "default": {}
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Metrics",
            "default": {}
          },
          "video_rankings": {
            "items": {
              "$ref": "#/components/schemas/CandidateScore"
            },
            "type": "array",
            "title": "Video Rankings",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "request",
          "sources",
          "job"
        ],
        "title": "Lesson"
      },
      "NarrationUnit": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 600,
            "minLength": 10,
            "title": "Text"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          },
          "beat_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Beat Id"
          },
          "scene_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scene Id"
          },
          "purpose": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purpose"
          },
          "start_ms": {
            "type": "integer",
            "title": "Start Ms",
            "default": 0
          },
          "end_ms": {
            "type": "integer",
            "title": "End Ms",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "evidence"
        ],
        "title": "NarrationUnit"
      },
      "Objective": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 5,
            "title": "Title"
          },
          "template": {
            "type": "string",
            "enum": [
              "process",
              "comparison",
              "example",
              "timeline",
              "chart",
              "steps",
              "cycle",
              "dos_donts",
              "key_fact"
