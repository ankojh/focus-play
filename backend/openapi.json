            "title": "Template"
          },
          "prerequisites": {
            "items": {
              "type": "string",
              "maxLength": 80,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 4,
            "title": "Prerequisites"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "template",
          "prerequisites"
        ],
        "title": "Objective"
      },
      "ProviderHealth": {
        "properties": {
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "model_ready": {
            "type": "boolean",
            "title": "Model Ready"
          },
          "speech_ready": {
            "type": "boolean",
            "title": "Speech Ready"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Digest"
          },
          "speech_provider": {
            "type": "string",
            "title": "Speech Provider"
          },
          "voice": {
            "type": "string",
            "title": "Voice"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
