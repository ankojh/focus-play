# Copy to .env at the project root. The server reads it on start.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT=8192
OLLAMA_PREDICT=2200
SPEECH_PROVIDER=kokoro
KOKORO_VOICE=af_heart
# Development substitute only: SPEECH_PROVIDER=macos
MACOS_VOICE=Samantha
# Required for new lessons. Enable YouTube Data API v3 for this server key.
# Public English captions use youtube-transcript-api; no paid service is used.
YOUTUBE_API_KEY=
DATA_DIR=.data
HF_HUB_OFFLINE=1
