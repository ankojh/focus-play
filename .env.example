# Copy to .env at the project root. The server reads it on start.
# Primary local runtime; start explicitly BEFORE the API. Base URL includes /v1.
LLM_PROVIDER=turbofieldfare
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_CONTEXT=16384
LLM_MAX_OUTPUT_TOKENS=2200
LLM_IDENTITY_RECEIPT=.runtime/turbofieldfare-launch.json
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=120
LLM_ATTEMPT_TIMEOUT=300
# Compact production tasks: whole stage including its one allowed repair.
LLM_TASK_TIMEOUT=60
# First-video processing window after dequeue (not a promised success time).
# TurboFieldfare streams are closed at the deadline; synchronous source/speech
# work observes cancellation at its existing call/unit boundaries.
FIRST_PLAYABLE_TIMEOUT=180
# Explicit rollback (replace LLM_PROVIDER/BASE_URL/MODEL/CONTEXT above):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=gemma4:12b-mlx
# LLM_CONTEXT=8192
# Legacy OLLAMA_* profiles remain valid when no LLM_PROVIDER is selected.
# LLM_* values take precedence; TurboFieldfare NEVER inherits OLLAMA_* values.
SPEECH_PROVIDER=kokoro
KOKORO_VOICE=af_heart
# Development substitute only: SPEECH_PROVIDER=macos
MACOS_VOICE=Samantha
# Required for new lessons. Enable YouTube Data API v3 for this server key.
YOUTUBE_API_KEY=
# Required for new lessons. Supadata reads existing YouTube captions from its own
# servers, so YouTube does not rate-limit this computer. Free plan: 100 credits/month.
SUPADATA_API_KEY=
# Transcripts requested per search round (2 to 15). Retain up to 3 in search
# order with channel diversity; no blocking LLM ranking on the production path.
# Each request costs one Supadata credit, including videos without captions.
RANK_CANDIDATES=8
# Cover image per short. openverse: licensed photos (needs internet; Wikimedia Commons fallback).
# generate: local Z-Image-Turbo via mflux in its own environment (.runtime/imagegen), about 14 s per image on an M3 Max.
# off: no cover.
IMAGE_SEARCH=openverse
# IMAGEGEN_PYTHON=.runtime/imagegen/bin/python
# IMAGEGEN_MODEL=filipstrand/Z-Image-Turbo-mflux-4bit
# Includes managed raster assets and their SQLite provenance/reference records.
# Assets are local bundled fixtures only: no asset URL/provider/upload settings.
# Fixed limits: 5 MB, 4096 px per dimension, 8 million decoded pixels; PNG/JPEG only.
DATA_DIR=.data
HF_HUB_OFFLINE=1
