# Copy to .env at the project root. The server reads it on start.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT=8192
OLLAMA_PREDICT=2200
SPEECH_PROVIDER=kokoro
KOKORO_VOICE=af_heart
# Development substitute only: SPEECH_PROVIDER=macos
MACOS_VOICE=Samantha
# Required for new lessons. Enable YouTube Data API v3 for this server key.
YOUTUBE_API_KEY=
# Required for new lessons. Supadata reads existing YouTube captions from its own
# servers, so YouTube does not rate-limit this computer. Free plan: 100 credits/month.
SUPADATA_API_KEY=
# Transcripts requested and ranked by the local model per search round (2 to 15).
# Each request costs one Supadata credit, including videos without captions.
RANK_CANDIDATES=8
DATA_DIR=.data
HF_HUB_OFFLINE=1
